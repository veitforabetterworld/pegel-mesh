(footprint "L_4030_HandSolder"
	(version 20241229)
	(generator "pegel-stapel")
	(layer "F.Cu")
	(descr "Leistungsspule 4 x 4 x 3 mm (Sunlord SWPA4030S), Pads 0,45 mm ueber das Teil hinaus fuer den Kolben")
	(attr smd exclude_from_pos_files exclude_from_bom)
	(property "Reference" "REF**" (at 0 0 90) (layer "F.SilkS")
		(effects (font (size 0.8 0.8) (thickness 0.12))))
	(property "Value" "VAL**" (at 0 3 0) (layer "F.Fab")
		(effects (font (size 0.5 0.5) (thickness 0.08))))
	(fp_rect (start -2 -2) (end 2 2) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_rect (start -2.7 -2.25) (end 2.7 2.25) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(pad "1" smd roundrect (at -1.7 0) (size 1.5 3.7) (layers "F.Cu" "F.Mask") (roundrect_rratio 0.1))
	(pad "2" smd roundrect (at 1.7 0) (size 1.5 3.7) (layers "F.Cu" "F.Mask") (roundrect_rratio 0.1))
	(model "${KICAD10_3DMODEL_DIR}/Inductor_SMD.3dshapes/L_Sunlord_SWPA4030S.step"
		(offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
