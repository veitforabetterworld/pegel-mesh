(footprint "L_3015_HandSolder"
	(version 20241229)
	(generator "pegel-stapel")
	(layer "F.Cu")
	(descr "Leistungsspule 3 x 3 x 1,5 mm (Sunlord SWPA3015S u. a.), Pads 0,45 mm ueber das Teil hinaus fuer den Kolben")
	(attr smd)
	(property "Reference" "REF**" (at 0 0 90) (layer "F.SilkS")
		(effects (font (size 0.7 0.7) (thickness 0.11))))
	(property "Value" "VAL**" (at 0 2.5 0) (layer "F.Fab")
		(effects (font (size 0.5 0.5) (thickness 0.08))))
	(fp_rect (start -1.5 -1.5) (end 1.5 1.5) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_rect (start -2.2 -1.75) (end 2.2 1.75) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(pad "1" smd roundrect (at -1.275 0) (size 1.35 2.7) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.1) (solder_paste_margin_ratio -0.05))
	(pad "2" smd roundrect (at 1.275 0) (size 1.35 2.7) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.1) (solder_paste_margin_ratio -0.05))
	(model "${KICAD10_3DMODEL_DIR}/Inductor_SMD.3dshapes/L_Sunlord_SWPA3015S.step"
		(offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
